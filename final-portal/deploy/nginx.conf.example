# Operator must replace the example origin and supply real TLS files.
# The Python service remains on loopback. No private data alias is exposed.
server {
    listen 443 ssl;
    server_name portal.example.invalid;
    ssl_certificate /etc/portal/tls/fullchain.pem;
    ssl_certificate_key /etc/portal/tls/privkey.pem;
    client_max_body_size 10m;
    add_header Strict-Transport-Security "max-age=31536000" always;
    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 120s;
    }
}
